# Copy to .env for local runs. In GitHub Actions these come from repository secrets.

# Postgres (read by both the Python loader and dbt)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=supermarket
PGSSLMODE=prefer            # use "require" for hosted Postgres such as Neon or Supabase

# Source. true = use the built in POS simulator to create each hour's export.
SIMULATE_SOURCE=true
INCIDENT_PROBABILITY=0.03   # chance a store has a faulty till in a given hour
BAD_RECORD_RATE=0.05        # share of that store's lines that come through broken
STORE_OUTAGE_PROBABILITY=0.01

# Scheduling and data quality
LOOKBACK_HOURS=24                     # how far back "hourly" looks for missing hours
REJECT_RATE_CRITICAL_THRESHOLD=0.05   # above this share of rejected rows, alert is CRITICAL

# Alerting. Leave blank and alerts are written to the log instead.
ALERT_MIN_SEVERITY=warning            # info, warning or critical
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                        # for Gmail, use an App Password, not your normal password
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=                       # comma separated
SLACK_WEBHOOK_URL=
HEALTHCHECK_URL=                      # optional, pinged after every healthy run
